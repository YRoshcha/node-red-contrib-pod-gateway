  {
    "id": "retention-retry-build-burst",
    "type": "function",
    "z": "retention-retry-tab",
    "name": "Create 5 requests",
    "func": "const messages = [];\nfor (let index = 1; index <= 5; index++) {\n    messages.push({ payload: { kind: 'burst', index } });\n}\nreturn [messages];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
