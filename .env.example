# Primary settings live in gateway.config.json. These variables are optional
# deployment-time overrides (for example, injected by Docker/Kubernetes).
POD_GATEWAY_CONFIG=./gateway.config.json
REDIS_URL=redis://127.0.0.1:6379
PORT=8080
GATEWAY_TOKEN=change-me
GATEWAY_RATE_LIMITS={"upstream":{"rate":50,"burst":1}}
GATEWAY_MAX_QUEUE=10000
GATEWAY_CONCURRENCY=32
REDIS_RESULT_TTL_SECONDS=3600
REDIS_DELETE_ON_ACK=true
REDIS_RETRY_POLL_MS=250
UPSTREAM_BASE_URL=https://api.example.com
UPSTREAM_PATH=/v1/resource
UPSTREAM_METHOD=GET
UPSTREAM_API_KEY=replace-me
